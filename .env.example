# ============================================================================
#  配置模板
# ----------------------------------------------------------------------------
#  用法：
#    cp .env.example .env
#    然后编辑 .env，把 change_me 换成你的真实值
#
#  ⚠️ .env 已在 .gitignore 中排除，不会被提交到 Git。
#     这个 .env.example 只放占位符，不要写任何真实密码！
# ============================================================================

# ---- MySQL（Docker 集群内）----
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=shop
# 对外暴露端口避开本机原生 MySQL 的 3306
MYSQL_PORT=13306

# ---- PostgreSQL ----
# 从容器内访问宿主机上的 pg，用 host.docker.internal
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DB=shop
PG_USER=shop
PG_PASSWORD=change_me

# ---- PostgreSQL CDC（逻辑复制专用账号）----
# 需要 REPLICATION 权限 + SELECT 权限 + 对 database 的 CREATE 权限
CDC_USER=flink_cdc
CDC_PASSWORD=change_me
CDC_SLOT=flink_users_slot
CDC_PUBLICATION=flink_cdc_pub
# 快照模式：initial（全量+增量）| never（纯增量）
# ⚠️ 没有 latest 这个值，写了会报 invalid
CDC_SNAPSHOT_MODE=initial

# ---- Kafka ----
KAFKA_BOOTSTRAP=kafka:9092

# ---- Flink ----
FLINK_REST_PORT=8081
